{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dynamic-comic-video:motion_plan:0.1",
  "title": "motion_plan",
  "type": "object",
  "properties": {
    "version": {
      "enum": ["0.1", "0.2"]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_mode": {
      "enum": [
        "fixture",
        "production"
      ]
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "performance": {
            "type": "object",
            "properties": {
              "intent": {"type": "string", "minLength": 1},
              "static_reason": {"type": "string", "minLength": 1},
              "reviewed": {"type": "boolean"}
            },
            "required": ["intent", "reviewed"],
            "additionalProperties": false
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 2
          },
          "transition": {
            "const": "cut"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "layer_id": {
                  "type": "string",
                  "minLength": 1
                },
                "acting": {"$ref": "#/$defs/acting"},
                "asset": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\).+"
                },
                "z": {
                  "type": "integer"
                },
                "from": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 1.3
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "scale"
                  ],
                  "additionalProperties": false
                },
                "to": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 1.3
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "scale"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "layer_id",
                "asset",
                "z",
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "review": {
            "type": "object",
            "properties": {
              "master_alignment": {
                "type": "boolean"
              },
              "background_completed": {
                "type": "boolean"
              },
              "motion_bounds_checked": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "master_alignment",
              "background_completed",
              "motion_bounds_checked",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "shot_id",
          "start_frame",
          "duration_frames",
          "transition",
          "layers",
          "review"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "project_id",
    "asset_mode",
    "shots"
  ],
  "additionalProperties": false,
  "$defs": {
    "acting": {
      "type": "object",
      "properties": {
        "part": {"enum": ["whole", "head", "arm", "hand", "eyes", "mouth", "prop", "interface"]},
        "pivot": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2},
        "keys": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "frame": {"type": "integer", "minimum": 0},
              "x": {"type": "number"}, "y": {"type": "number"},
              "rotation": {"type": "number", "minimum": -180, "maximum": 180},
              "opacity": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "required": ["frame", "x", "y", "rotation", "opacity"], "additionalProperties": false
          }
        },
        "poses": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "frame": {"type": "integer", "minimum": 0},
              "asset": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\).+"}
            }, "required": ["frame", "asset"], "additionalProperties": false
          }
        }
      },
      "required": ["part", "pivot", "keys"], "additionalProperties": false
    }
  }
}
